# ── Binance credentials (opcional — endpoints públicos no requieren clave) ──
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── URL base de Binance Futures ───────────────────────────────────────────
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com

# ── Scanner ───────────────────────────────────────────────────────────────
SCANNER_CANDIDATE_LIMIT=50
SCANNER_RESULT_LIMIT=20
MIN_QUOTE_VOLUME_USDT=50000000
MAX_SPREAD_PCT=0.08

# ── Umbrales de alertas (score 0-100 por tipo de acción) ─────────────────
MIN_ALERT_SCORE_BUY_SPOT=72
MIN_ALERT_SCORE_SELL_SPOT=68
MIN_ALERT_SCORE_LONG_FUTURES=70
MIN_ALERT_SCORE_SHORT_FUTURES=70
EXTREME_FUNDING_ABS=0.001

# ── Liquidaciones ─────────────────────────────────────────────────────────
ENABLE_LIQUIDATIONS=true

# ── Base de datos local ───────────────────────────────────────────────────
ENABLE_DATABASE=true
DATABASE_PATH=data/crypto_dashboard.sqlite3
SNAPSHOT_RETENTION_DAYS=7
SNAPSHOT_MIN_SCORE=30

# ── Outcome tracker ───────────────────────────────────────────────────────
OUTCOME_TRACKER_ENABLED=true
OUTCOME_HORIZONS_MINUTES=15,60,240,1440

# ── Reporte periódico de win rate ─────────────────────────────────────────
WINRATE_REPORT_ENABLED=true
WINRATE_REPORT_INTERVAL_HOURS=0.1667
WINRATE_REPORT_WINDOW_HOURS=24

# ── Notificaciones — Discord ──────────────────────────────────────────────
ENABLE_DISCORD_ALERTS=false
DISCORD_WEBHOOK_URL=
ALERT_COOLDOWN_SECONDS=900
ALERT_MIN_CONFIDENCE_DELTA_RESEND=10

# ── Notificaciones — Telegram ─────────────────────────────────────────────
ENABLE_TELEGRAM_ALERTS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Notificaciones — Email (SMTP TLS) ─────────────────────────────────────
ENABLE_EMAIL_ALERTS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# ── Continuación de tendencia (segunda vía de alerta sin gatillo clásico) ──
# Activa detección de tendencias fuertes sostenidas (JTO/STG/WLD style).
# Empieza en true para observar — sin bloqueo hasta que ENABLE_SETUP_GATE=true.
ENABLE_TREND_CONTINUATION=true
# Score mínimo de la función calculate_trend_priority_score para validar
TREND_CONTINUATION_MIN_SCORE=75
# Cuántos de los últimos N snapshots deben cumplir la condición base
TREND_CONTINUATION_MIN_PERSISTENCE=3
# Tamaño de la ventana de historia (últimos N ciclos de scan)
TREND_CONTINUATION_LOOKBACK=10

# ── Setup evaluation (sistema de decisión disciplinado) ───────────────────
# Detecta gatillos de price action (engulfing, rechazo, VWAP reclaim)
ENABLE_PRICE_ACTION_TRIGGER=true
# Calcula y guarda grade A/B/C/NO_TRADE por setup (observación, sin bloqueo)
ENABLE_SETUP_EVALUATION=true
# IMPORTANTE: empieza en false — activa solo cuando valides que no bloquea demasiado
ENABLE_SETUP_GATE=false
# Score mínimo para que un setup sea válido
SETUP_MIN_SCORE=70
# Grades que pueden generar alerta cuando el gate está activo
SETUP_ALERT_GRADES=A,B

# ── Machine Learning (filtro de probabilidad de TP1) ─────────────────────
# Activa el filtro ML (requiere correr scripts/train_model.py primero)
ML_ENABLED=false
# Probabilidad mínima para no filtrar la señal (0-1)
ML_THRESHOLD=0.52
# Ruta al modelo entrenado (generado por scripts/train_model.py)
ML_MODEL_PATH=data/ml_model.pkl
# Muestras mínimas para entrenar (evita modelos basura con pocos datos)
ML_MIN_SAMPLES=50

# ── Auto-trading (paper o real) ───────────────────────────────────────────
# Activar el módulo de auto-trading
AUTO_TRADING_ENABLED=false
# Modo: paper (simulado sin dinero real) | real (requiere API key con permiso trading)
AUTO_TRADING_MODE=paper
# Capital simulado en paper mode (USDT)
# Con $100 y tiers 3%/2%/1% -> $3/$2/$1 por trade (x5 lev = $15/$10/$5 exposicion)
AUTO_TRADING_CAPITAL_USDT=100
# Máximo de posiciones abiertas simultáneamente
AUTO_TRADING_MAX_POSITIONS=5
# Mercados habilitados: futures | spot | both
AUTO_TRADING_MARKETS=futures
# Score mínimo para abrir posición
AUTO_TRADING_MIN_SCORE=70
# Cerrar posición automáticamente tras N horas sin resolver TP/SL
AUTO_TRADING_TIMEOUT_HOURS=4
# Tiers de sizing por score (% del capital)
AUTO_TRADING_TIER1_SCORE=80
AUTO_TRADING_TIER2_SCORE=75
AUTO_TRADING_TIER3_SCORE=70
# Intervalo del reporte de posiciones a Telegram (segundos, 600 = 10 min)
POSITION_REPORT_INTERVAL_SECONDS=600
