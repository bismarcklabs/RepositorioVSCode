# ── Binance credentials (opcional — endpoints públicos no requieren clave) ──
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── KuCoin credentials ────────────────────────────────────────────────────
# Requeridas solo cuando AUTO_TRADING_MODE=real y AUTO_TRADING_EXCHANGE=kucoin
# Permisos necesarios en el API key:
#   - Spot Trading:    "Trade" (en General)
#   - Futures Trading: "Trade" (en KuCoin Futures)
# Guía para generar: https://www.kucoin.com/account/api
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_PASSPHRASE=
# true = usa endpoints sandbox de KuCoin para probar sin dinero real
KUCOIN_SANDBOX=false

# ── URL base de Binance Futures ───────────────────────────────────────────
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com

# ── Scanner ───────────────────────────────────────────────────────────────
SCANNER_CANDIDATE_LIMIT=50
SCANNER_RESULT_LIMIT=20
MIN_QUOTE_VOLUME_USDT=50000000
MAX_SPREAD_PCT=0.08

# ── Umbrales de alertas (score 0-100 por tipo de acción) ─────────────────
MIN_ALERT_SCORE_BUY_SPOT=85
MIN_ALERT_SCORE_SELL_SPOT=68
MIN_ALERT_SCORE_LONG_FUTURES=70
MIN_ALERT_SCORE_SHORT_FUTURES=70
EXTREME_FUNDING_ABS=0.001

# ── Liquidaciones ─────────────────────────────────────────────────────────
ENABLE_LIQUIDATIONS=true

# ── Base de datos local ───────────────────────────────────────────────────
ENABLE_DATABASE=true
DATABASE_PATH=data/crypto_dashboard.sqlite3
SNAPSHOT_RETENTION_DAYS=7
SNAPSHOT_MIN_SCORE=30

# ── Outcome tracker ───────────────────────────────────────────────────────
OUTCOME_TRACKER_ENABLED=true
OUTCOME_HORIZONS_MINUTES=15,60,240,1440

# News intelligence observacional: no modifica score ni abre posiciones
NEWS_INTELLIGENCE_ENABLED=false
NEWS_GDELT_ENABLED=true
NEWS_GOOGLE_RSS_ENABLED=true
CRYPTOPANIC_AUTH_TOKEN=
NEWS_RSS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://zfnd.org/feed/,https://shieldedlabs.net/feed/
NEWS_COLLECTION_INTERVAL_SECONDS=900
NEWS_REPORT_INTERVAL_SECONDS=3600
NEWS_LOOKBACK_HOURS=6
NEWS_MAX_SYMBOLS=20
# Tokens que deben vigilarse aunque no superen el filtro de volumen del scanner
NEWS_WATCH_SYMBOLS=BABYUSDT,AAVEUSDT,ZECUSDT
NEWS_MIN_ABS_SCORE=5
NEWS_OUTCOME_HORIZON_MINUTES=60
SECURITY_ALERTS_ENABLED=true
SECURITY_ALERT_MIN_ABS_SCORE=15
SECURITY_ALERT_LOOKBACK_HOURS=168
SECURITY_COLLECTION_INTERVAL_SECONDS=300
SECURITY_GITHUB_REPOS=zcash/zcash|ZECUSDT,ZcashFoundation/zebra|ZECUSDT

# ── Reporte periódico de win rate ─────────────────────────────────────────
WINRATE_REPORT_ENABLED=true
WINRATE_REPORT_INTERVAL_HOURS=0.1667
WINRATE_REPORT_WINDOW_HOURS=24

# ── Notificaciones — Discord ──────────────────────────────────────────────
ENABLE_DISCORD_ALERTS=false
DISCORD_WEBHOOK_URL=
ALERT_COOLDOWN_SECONDS=900
ALERT_MIN_CONFIDENCE_DELTA_RESEND=10

# ── Notificaciones — Telegram ─────────────────────────────────────────────
ENABLE_TELEGRAM_ALERTS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Notificaciones — Email (SMTP TLS) ─────────────────────────────────────
ENABLE_EMAIL_ALERTS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# ── Continuación de tendencia (segunda vía de alerta sin gatillo clásico) ──
# Activa detección de tendencias fuertes sostenidas (JTO/STG/WLD style).
# Empieza en true para observar — sin bloqueo hasta que ENABLE_SETUP_GATE=true.
ENABLE_TREND_CONTINUATION=true
# Score mínimo de la función calculate_trend_priority_score para validar
TREND_CONTINUATION_MIN_SCORE=75
# Cuántos de los últimos N snapshots deben cumplir la condición base
TREND_CONTINUATION_MIN_PERSISTENCE=3
# Tamaño de la ventana de historia (últimos N ciclos de scan)
TREND_CONTINUATION_LOOKBACK=10

# ── Micro-scalping agresivo (alertas separadas) ───────────────────────────
MICRO_SCALP_ENABLED=true
MICRO_SCALP_MIN_SCORE=75
MICRO_SCALP_STRONG_SCORE=85
MICRO_SCALP_MIN_RVOL=2.0
MICRO_SCALP_MIN_RETURN_5M=0.20
MICRO_SCALP_MIN_RETURN_3M=0.10
MICRO_SCALP_MAX_SPREAD_PCT=0.06
MICRO_SCALP_TIMEOUT_MINUTES=30
MICRO_SCALP_FORCE_CLOSE_AFTER_MINUTES=60
MICRO_SCALP_ALERT_COOLDOWN_SECONDS=180

# ── Régimen global BTC: penaliza operaciones contra el mercado ────────────
BTC_REGIME_ENABLED=true
BTC_RISK_OFF_RETURN_1H=-1.0
BTC_RISK_OFF_RETURN_15M=-0.5
BTC_RISK_OFF_RETURN_5M=-0.15
BTC_RISK_ON_RETURN_1H=1.0
BTC_RISK_ON_RETURN_15M=0.5
BTC_RISK_ON_RETURN_5M=0.15
BTC_REGIME_BLOCK_COUNTERTREND_BELOW_SCORE=85
BTC_REGIME_COUNTERTREND_CONFIDENCE_PENALTY=10
BTC_REGIME_ALIGNED_CONFIDENCE_BOOST=5

# ── Setup evaluation (sistema de decisión disciplinado) ───────────────────
# Detecta gatillos de price action (engulfing, rechazo, VWAP reclaim)
ENABLE_PRICE_ACTION_TRIGGER=true
# Calcula y guarda grade A/B/C/NO_TRADE por setup (observación, sin bloqueo)
ENABLE_SETUP_EVALUATION=true
# IMPORTANTE: empieza en false — activa solo cuando valides que no bloquea demasiado
ENABLE_SETUP_GATE=false
# Score mínimo para que un setup sea válido
SETUP_MIN_SCORE=70
# Grades que pueden generar alerta cuando el gate está activo
SETUP_ALERT_GRADES=A,B

# ── Machine Learning (filtro de probabilidad de TP1) ─────────────────────
# Activa el filtro ML (requiere correr scripts/train_model.py primero)
ML_ENABLED=false
# Probabilidad mínima para no filtrar la señal (0-1)
ML_THRESHOLD=0.52
# Ruta al modelo entrenado (generado por scripts/train_model.py)
ML_MODEL_PATH=data/ml_model.pkl
# Muestras mínimas para entrenar (evita modelos basura con pocos datos)
ML_MIN_SAMPLES=50

# ── Auto-trading (paper o real) ───────────────────────────────────────────
# Activar el módulo de auto-trading
AUTO_TRADING_ENABLED=false
# Modo: paper (simulado sin dinero real) | real (ejecuta en exchange)
AUTO_TRADING_MODE=paper
# Exchange donde ejecutar en modo real. Solo "kucoin" está soportado actualmente.
# Ignorado si AUTO_TRADING_MODE=paper.
AUTO_TRADING_EXCHANGE=kucoin
# Capital simulado en paper mode (USDT)
# Con $100 y tiers 3%/2%/1% -> $3/$2/$1 por trade (x5 lev = $15/$10/$5 exposicion)
AUTO_TRADING_CAPITAL_USDT=100
# Máximo de posiciones abiertas simultáneamente
AUTO_TRADING_MAX_POSITIONS=5
# Mercados habilitados: futures | spot | both
AUTO_TRADING_MARKETS=both
# Score mínimo para abrir posición (global, se puede sobreescribir por dirección)
AUTO_TRADING_MIN_SCORE=70
# Score mínimo diferenciado por dirección — validado con 4,000+ trades paper:
# LONG 75+ → WR_adj 55-60%; SHORT EV negativo en mercado alcista, requiere mayor convicción
AUTO_TRADING_LONG_MIN_SCORE=75
AUTO_TRADING_SHORT_MIN_SCORE=80
# Cerrar posición automáticamente tras N horas sin resolver TP/SL
# Validado con 854K velas: 6h resuelve 60% de trades vs 25% con 2h (antiguo)
AUTO_TRADING_TIMEOUT_HOURS=6
# Corte defensivo si una posicion supera perdida maxima antes del timeout
AUTO_TRADING_RISK_CUT_ENABLED=true
AUTO_TRADING_RISK_CUT_MIN_HOURS=1
AUTO_TRADING_RISK_CUT_LOSS_PCT=8
# Tiers de sizing por score (% del capital)
AUTO_TRADING_TIER1_SCORE=80
AUTO_TRADING_TIER2_SCORE=75
AUTO_TRADING_TIER3_SCORE=70
# Intervalo del reporte de posiciones a Telegram (segundos, 600 = 10 min)
POSITION_REPORT_INTERVAL_SECONDS=600

# Calibracion paralela y protecciones de auto-trading
CALIBRATED_SETUP_ENABLED=true
CALIBRATION_VERSION=rules-v1-observe
AUTO_TRADING_USE_CALIBRATED_GRADE=true
AUTO_TRADING_ALLOWED_CALIBRATED_GRADES=A,B,C
AUTO_TRADING_C_SHORT_MIN_SCORE=75
AUTO_TRADING_C_LONG_MIN_SCORE=85
AUTO_TRADING_COUNTERTREND_MIN_SCORE=90
AUTO_TRADING_LOSS_COOLDOWN_COUNT=2
AUTO_TRADING_LOSS_COOLDOWN_HOURS=6
AUTO_TRADING_PAPER_MAX_LOSS_PCT=12
# Gate de sesión horaria: bloquea entradas en horas de baja volatilidad (Asia 00-08h UTC)
# Validado con 90d × 25 símbolos: EV negativo con SL2%/TP3% en esas horas
# Formato de horas activas: "HH-HH" separado por coma (ej. "9-17,20-23")
AUTO_TRADING_SESSION_GATE_ENABLED=true
AUTO_TRADING_SESSION_ACTIVE_HOURS=9-22
MICRO_LONG_MIN_SCORE=80
